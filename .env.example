# =============================================================================
# .env — Environment configuration for G1 XR Teleoperation
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This file is loaded by docker compose automatically.
# DO NOT commit .env to git (it contains your network topology).
# =============================================================================

# -----------------------------------------------------------------------------
# ROBOT CONFIGURATION
# These must match your physical hardware exactly.
# -----------------------------------------------------------------------------

# G1 arm variant.
# G1_29 = G1 with 29 DoF (7-DoF arms). This is the correct choice for the
#         standard G1 EDU with full dexterous hands.
# G1_23 = G1 with 23 DoF (simpler arm configuration).
ARM=G1_29

# End-effector type attached to the G1 arms.
# dex3 = Unitree Dex3-1 dexterous hand (7 finger joints per hand, 2 hands).
#        Hand pose from Quest 3 hand tracking is retargeted to these joints.
# dex1 = Unitree Dex1-1 simple gripper (open/close only).
EE=dex3

# IP address of the G1 robot's onboard Development Computing Unit (PC2).
# This is fixed at 192.168.123.164 on the robot's internal network.
IMG_SERVER_IP=192.168.123.164

# -----------------------------------------------------------------------------
# TELEOPERATION BEHAVIOUR
# -----------------------------------------------------------------------------

# XR input mode:
#   hand       = Meta Quest 3 hand tracking (21 keypoints per hand).
#                Moves your physical hands → robot follows in real time.
#   controller = Meta Quest 3 Touch controllers.
#                Trigger controls gripper; joystick controls walking (with --motion).
INPUT_MODE=hand

# XR display mode inside the Quest 3 headset:
#   immersive    = Full robot first-person view (most immersive, no passthrough).
#   ego          = Passthrough + small first-person window overlay.
#   pass-through = Passthrough only (useful for initial setup and orientation).
DISPLAY_MODE=immersive

# Control loop frequency in Hz.
# 30.0 is the default and works well for most tasks.
# Do not exceed 50.0 without testing IK solver latency first.
FREQUENCY=30.0

# -----------------------------------------------------------------------------
# MODE FLAGS
# Set to "true" to enable, "false" to disable.
# -----------------------------------------------------------------------------

# Motion mode: allows arm teleoperation while the robot walks.
# IMPORTANT: Requires waist motor. Your G1 EDU has NO waist motor.
# Leave this as false — arm-only (debug) mode is the correct mode for your robot.
MOTION=false

# Headless mode: disable all visualisation windows.
# Set to true when running on a machine without a display (e.g. inside tmux over SSH).
HEADLESS=false

# Isaac Lab simulation mode.
# Set to true to test with the simulator before touching the real robot.
# Requires unitree_sim_isaaclab to be running first.
SIM=false

# Recording mode: captures arm joint states, hand joint states, and camera frames
# at each timestep for use as imitation learning training data.
# Press [s] to start/stop episodes after pressing [r] to begin teleoperation.
RECORD=false

# -----------------------------------------------------------------------------
# RECORDING METADATA
# Only used when RECORD=true. Saved into the episode JSON header.
# -----------------------------------------------------------------------------
TASK_NAME=pick_cube
TASK_GOAL=Pick up the red cube and place it in the bin.
TASK_DESC=Tabletop pick-and-place task using G1 with Dex3-1 hands.
TASK_STEPS=step1: approach object; step2: open hand; step3: grasp; step4: lift; step5: place;

# -----------------------------------------------------------------------------
# NETWORKING
# -----------------------------------------------------------------------------

# The name of the Ethernet network interface on the Host that connects to the
# robot's network. Leave blank to let CycloneDDS auto-detect.
# Find yours with: ip link show
# Common values: eth0, enp3s0, enp0s31f6, eno1
NETWORK_INTERFACE=

# ZMQ port used by the PC2 image server. Must match docker-compose.pc2.yml.
ZMQ_PORT=5555
